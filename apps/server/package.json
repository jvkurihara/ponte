{
  "name": "@ponte/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/apps/server/src/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "smtp:check": "node --import tsx src/check-smtp.ts"
  },
  "dependencies": {
    "@ponte/shared": "1.0.0",
    "@prisma/client": "6.19.3",
    "cookie": "^1.0.2",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "nodemailer": "^10.0.10",
    "socket.io": "^4.8.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "prisma": "6.19.3"
  }
}
