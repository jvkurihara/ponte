NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://ponte:ponte_local@localhost:5432/ponte?schema=public
# Set to 1 ONLY behind one trusted reverse proxy that overwrites Forwarded headers.
TRUST_PROXY_HOPS=0
SESSION_DAYS=7
# Mailpit supplied in compose.yaml: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ponte <no-reply@ponte.local>"
# Optional. Empty: local-network host candidates only.
STUN_URLS=
# Optional coturn REST credentials. Never put this secret in VITE_* variables.
TURN_URLS=
TURN_SHARED_SECRET=
TURN_TTL_SECONDS=86400
